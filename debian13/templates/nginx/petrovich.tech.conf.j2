# petrovich.tech — кастом со старого BitrixEnv
# Основной сайт проксируется в Apache с префиксом {{ bitrix_petrovich_proxy_prefix }}
# HTTP тоже обслуживается (нужно для временного proxy со старого сервера на :80).

{% macro petrovich_locations() %}
    # Push & Pull (как на старом petrovich.tech.conf)
    location ^~ /bitrix/pub/ {
        access_log off;
        proxy_pass http://nodejs_pub;
        proxy_max_temp_file_size 0;
        proxy_read_timeout 43800;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $replace_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location ~* ^/bitrix/subws/ {
        access_log off;
        proxy_pass http://nodejs_sub;
        proxy_max_temp_file_size 0;
        proxy_read_timeout 43800;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $replace_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location ~* ^/bitrix/sub/ {
        access_log off;
        rewrite ^/bitrix/sub/(.*)$ /bitrix/subws/$1 break;
        proxy_pass http://nodejs_sub;
        proxy_max_temp_file_size 0;
        proxy_read_timeout 43800;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location ~* ^/bitrix/rest/ {
        access_log off;
        proxy_pass http://nodejs_pub;
        proxy_max_temp_file_size 0;
        proxy_read_timeout 43800;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        proxy_pass http://apache{{ bitrix_petrovich_proxy_prefix }};
        proxy_connect_timeout {{ bitrix_proxy_connect_timeout }};
        proxy_send_timeout {{ bitrix_proxy_send_timeout }};
        proxy_read_timeout {{ bitrix_proxy_read_timeout }};
    }
{% endmacro %}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    server_name {{ bitrix_petrovich_server_name }};
    server_name_in_redirect off;

    ssl_certificate     {{ bitrix_ssl_dir }}/{{ bitrix_petrovich_cert }};
    ssl_certificate_key {{ bitrix_ssl_dir }}/{{ bitrix_petrovich_key }};
    include conf.d/ssl-params.conf;

    large_client_header_buffers 8 32k;
    client_max_body_size {{ bitrix_petrovich_client_max_body_size }};

    access_log /var/log/nginx/petrovich.tech_access.log json;
    error_log  /var/log/nginx/petrovich.tech_error.log warn;

    proxy_set_header X-Real-IP          $remote_addr;
    proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
    proxy_set_header Host               $host;
    proxy_set_header X-Forwarded-Host   $host;
    proxy_set_header X-Forwarded-Proto  $scheme;
    proxy_set_header X-Forwarded-Scheme $scheme;

{{ petrovich_locations() }}
}

server {
    listen 80;
    listen [::]:80;
    server_name {{ bitrix_petrovich_server_name }};
    server_name_in_redirect off;

    large_client_header_buffers 8 32k;
    client_max_body_size {{ bitrix_petrovich_client_max_body_size }};

    access_log /var/log/nginx/petrovich.tech_access.log json;
    error_log  /var/log/nginx/petrovich.tech_error.log warn;

    # Если запрос пришёл со старого прокси — схема для бэкенда https
    set $fwd_proto $scheme;
    if ($http_x_forwarded_proto != "") {
        set $fwd_proto $http_x_forwarded_proto;
    }

    proxy_set_header X-Real-IP          $remote_addr;
    proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
    proxy_set_header Host               $host;
    proxy_set_header X-Forwarded-Host   $host;
    proxy_set_header X-Forwarded-Proto  $fwd_proto;
    proxy_set_header X-Forwarded-Scheme $fwd_proto;

{{ petrovich_locations() }}
}
